{
  "name": "zero-to-hundred",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "מ־0 ל־100 — RAMON SAFETY DAY 2026 interactive scenario",
  "scripts": {
    "dev": "concurrently -n vite,worker -c magenta,blue \"vite\" \"wrangler dev --port 3000\"",
    "build": "vite build",
    "start": "npm run build && wrangler dev --port 3000",
    "deploy": "npm run build && wrangler deploy",
    "test": "node tests/engine.test.mjs && node tests/flow.test.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1",
    "vite": "^5.4.11",
    "wrangler": "^4.124.0"
  }
}